---
import { Image as AstroImage } from 'astro:assets';
import type { Locales } from 'astro';
import type { EmployeeBioFragment } from '../../../../__generated/sdk';
import { getOptimizelySdk } from '../../../graphql/getSdk';
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import Layout from '../../../layouts/Layout.astro';
import ContentArea from '../../shared/ContentArea/ContentArea.astro';
import { isEditContext } from '../../shared/utils.ts';

const isCmsEdit = isEditContext(Astro.url);

export interface Props {
    contentPayload: ContentPayload;
}
const { contentPayload } = Astro.props as Props;

const optiResponse = await getOptimizelySdk(contentPayload).pageById({
    key: contentPayload.key,
    //@ts-ignore
    loc: contentPayload.loc as Locales,
    ver: contentPayload.ver,
});
const bio = optiResponse?._Page?.item as EmployeeBioFragment;

const fullName = [bio?.FirstName, bio?.LastName].filter(Boolean).join(' ');
const headshot =
    (bio?.Headshot as any)?.item?.Url || bio?.Headshot?.url?.default;
const headshotAlt =
    (bio?.Headshot as any)?.item?.AltText ||
    (bio?.Headshot as any)?.item?._metadata?.displayName ||
    fullName ||
    'Employee headshot';

const defaultUrl = bio?._metadata?.url?.default || '';
const hierarchicalUrl =
    bio?._metadata?.url?.type === 'SIMPLE'
        ? bio?._metadata?.url?.hierarchical
        : '';

const metaDescription = bio?.JobTitle
    ? `${fullName} — ${bio.JobTitle}`
    : fullName;

const pageClass = 'page-employee-bio';
---

<Layout
    title={fullName || bio?._metadata?.displayName || 'Employee Bio'}
    description={metaDescription ?? ''}
    graphtype="profile"
    contentPayload={contentPayload}
    defaultUrl={defaultUrl}
    hierarchicalUrl={hierarchicalUrl ?? ''}
>
    <div class={`max-w-screen-6xl mx-auto ${pageClass}`}>
        <main class="mx-auto max-w-screen-xl px-4 py-10 2xl:px-0">
            <!-- Profile header: headshot + key info -->
            <section class="grid grid-cols-1 gap-8 md:grid-cols-[18rem_1fr] md:gap-12">
                <div class="mx-auto w-full max-w-xs md:mx-0">
                    {
                        headshot ? (
                            <AstroImage
                                src={headshot}
                                class="aspect-3/4 w-full rounded-2xl object-cover shadow-md"
                                alt={headshotAlt}
                                inferSize={true}
                                data-epi-edit={isCmsEdit ? 'Headshot' : undefined}
                            />
                        ) : (
                            <div
                                class="bg-base-200 flex aspect-3/4 w-full items-center justify-center rounded-2xl"
                                data-epi-edit={isCmsEdit ? 'Headshot' : undefined}
                            >
                                <span class="text-base-content/40 text-6xl font-semibold">
                                    {(bio?.FirstName?.[0] ?? '') +
                                        (bio?.LastName?.[0] ?? '')}
                                </span>
                            </div>
                        )
                    }
                </div>

                <div class="flex flex-col justify-center">
                    <h1
                        class="text-base-content text-4xl leading-tight font-semibold lg:text-5xl"
                    >
                        <span data-epi-edit={isCmsEdit ? 'FirstName' : undefined}
                            >{bio?.FirstName}</span
                        >
                        <span data-epi-edit={isCmsEdit ? 'LastName' : undefined}
                            >{bio?.LastName}</span
                        >
                    </h1>

                    {
                        bio?.JobTitle && (
                            <p
                                class="text-primary mt-2 text-xl font-medium lg:text-2xl"
                                data-epi-edit={isCmsEdit ? 'JobTitle' : undefined}
                            >
                                {bio.JobTitle}
                            </p>
                        )
                    }

                    <div class="mt-6 space-y-3 text-base">
                        {
                            bio?.Address && (
                                <p
                                    class="text-base-content/80 flex items-start gap-3"
                                    data-epi-edit={isCmsEdit ? 'Address' : undefined}
                                >
                                    <svg
                                        class="text-primary mt-1 h-5 w-5 flex-shrink-0"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"
                                        />
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                        />
                                    </svg>
                                    <span>{bio.Address}</span>
                                </p>
                            )
                        }
                        {
                            bio?.Phone && (
                                <p
                                    class="text-base-content/80 flex items-center gap-3"
                                    data-epi-edit={isCmsEdit ? 'Phone' : undefined}
                                >
                                    <svg
                                        class="text-primary h-5 w-5 flex-shrink-0"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                        />
                                    </svg>
                                    <a class="link link-hover" href={`tel:${bio.Phone}`}>
                                        {bio.Phone}
                                    </a>
                                </p>
                            )
                        }
                        {
                            bio?.Email && (
                                <p
                                    class="text-base-content/80 flex items-center gap-3"
                                    data-epi-edit={isCmsEdit ? 'Email' : undefined}
                                >
                                    <svg
                                        class="text-primary h-5 w-5 flex-shrink-0"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                        />
                                    </svg>
                                    <a class="link link-hover" href={`mailto:${bio.Email}`}>
                                        {bio.Email}
                                    </a>
                                </p>
                            )
                        }
                    </div>
                </div>
            </section>

            <!-- Biography -->
            {
                bio?.Bio?.html && (
                    <div class="divider my-10" />
                    <article
                        class="prose dark:prose-invert md:prose-lg max-w-none prose-img:rounded-2xl"
                        data-epi-edit={isCmsEdit ? 'Bio' : undefined}
                        set:html={bio.Bio.html}
                    />
                )
            }

            <!-- Additional content blocks -->
            {
                bio?.AdditionalContent && bio.AdditionalContent.length > 0 && (
                    <div
                        class="mt-12"
                        data-epi-edit={isCmsEdit ? 'AdditionalContent' : undefined}
                    >
                        {bio.AdditionalContent.map((contentAreaItem: any) => (
                            <ContentArea
                                contentPayload={contentPayload}
                                contentAreaItem={contentAreaItem}
                            />
                        ))}
                    </div>
                )
            }
        </main>
    </div>
</Layout>
